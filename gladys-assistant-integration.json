  ],
  "widgets": [
    {
      "key": "tempest_station",
      "label": {
        "en": "Tempest station",
        "fr": "Station Tempest",
        "de": "Tempest-Station",
        "es": "Estación Tempest"
      },
      "description": {
        "en": "Live weather, 24 h temperature, wind, lightning and connection of a station.",
        "fr": "Météo en direct, température sur 24 h, vent, foudre et connexion d'une station.",
        "de": "Live-Wetter, Temperatur über 24 Std., Wind, Blitze und Verbindung einer Station.",
        "es": "Tiempo en directo, temperatura en 24 h, viento, rayos y conexión de una estación."
      },
      "icon": "cloud-drizzle",
      "settings": [
        {
          "key": "station",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Station",
            "es": "Estación"
          }
        }
      ],
      "action_timeout_seconds": 20
    }
  ]
}
